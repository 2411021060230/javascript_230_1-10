let s = "cryptography";
let count = 0;

for (let i = 0; i < s.length; i++) {
    let ch = s[i].toLowerCase();

    if (
        ch === "a" ||
        ch === "e" ||
        ch === "i" ||
        ch === "o" ||
        ch === "u"
    ) {
        count++;
    }
}

console.log("Number of vowels:", count);
