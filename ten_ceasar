let msg = "HELLO";
let alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
let result = "";

for (let i = 0; i < msg.length; i++) {
    let index = alphabet.indexOf(msg[i]);   // Find position
    let newIndex = (index + 3) % 26;        // Shift by 3
    result += alphabet[newIndex];           // Get new letter
}

console.log(result);
